# Solana RPC Configuration
HELIUS_API_KEY=your-helius-api-key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your-helius-api-key
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-api-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/deathshot

# Your wallet (private key in base58 format)
WALLET_PRIVATE_KEY=your-private-key-here

# Risk Configuration
MAX_SOL_PER_TRADE=5.0
MAX_CONCURRENT_POSITIONS=10
MAX_EXPOSURE_PER_TOKEN=10.0
MAX_DAILY_LOSS_SOL=20.0
MAX_HOURLY_TRADES=50

# Signal Configuration
DIP_THRESHOLD_PCT=5.0
MIN_LIQUIDITY_SOL=1000.0
MAX_SLIPPAGE_PCT=3.0
MIN_VOLUME_PROXY=100.0
COOLDOWN_SECONDS=300

# Exit Configuration
TAKE_PROFIT_PCT=3.0
STOP_LOSS_PCT=2.0
TIME_STOP_SECONDS=300

# Logging
LOG_LEVEL=info
NODE_ENV=development

# Trading Mode
ENABLE_LIVE_TRADING=false
PAPER_TRADING=true
