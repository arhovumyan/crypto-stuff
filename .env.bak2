# ============================================================================
# Post-Absorption Trader Configuration
# ============================================================================
# This is NOT copy trading. This is post-liquidity absorption trading.
# We trade AFTER infrastructure wallets absorb sell pressure and price stabilizes.

# Enable Live Trading (START WITH false FOR PAPER TRADING!)
ABSORPTION_ENABLE_LIVE_TRADING=true

# Absorption Detection Parameters
ABSORPTION_MIN_SELL_VOLUME_USD=1000       # Min sell volume to qualify as "large pressure"
ABSORPTION_MIN_INFRA_BUY_USD=40           # Min infra wallet buy to qualify as "absorption"
ABSORPTION_MIN_RATIO=0.2                  # Min ratio: infra buy / sell volume (0.3 = 30%)
ABSORPTION_SELL_WINDOW_SEC=120            # Time to look back for sells before infra buy
ABSORPTION_WINDOW_SEC=300                 # Total window to look for absorption

# Stabilization Confirmation Parameters
STABILIZATION_MONITOR_SEC=180             # How long to monitor for stability (3 min)
STABILIZATION_MAX_VOLATILITY=5            # Max price volatility % allowed
STABILIZATION_MIN_SAMPLES=6               # Min price samples required
STABILIZATION_MIN_RECOVERY=0              # Min % recovery from absorption price (0 = can be flat)
STABILIZATION_MAX_DEVIATION=3             # Max % deviation from moving average

# Entry Parameters
ABSORPTION_BUY_AMOUNT_SOL=0.1             # Fixed SOL amount per position
ABSORPTION_MAX_SLIPPAGE_BPS=100           # Max slippage (100 = 1%)
ABSORPTION_MIN_LIQUIDITY_USD=50000        # Min liquidity required to enter
ABSORPTION_MAX_POSITIONS=5                # Max concurrent positions
ABSORPTION_TOKEN_COOLDOWN_SEC=3600        # Cooldown before trading same token again (1 hour)

# Exit Strategy Parameters
ABSORPTION_PROFIT_TARGET=20               # Profit target %
ABSORPTION_STOP_LOSS=15                   # Stop loss %
ABSORPTION_TRAILING_ACTIVATION=15         # % profit to activate trailing stop
ABSORPTION_TRAILING_DISTANCE=8            # % distance for trailing stop
ABSORPTION_MAX_HOLD_TIME_SEC=86400        # Max hold time (24 hours)
ABSORPTION_IDLE_EXIT_TIME_SEC=7200        # Exit if idle this long (2 hours)

# Risk Management
ABSORPTION_MAX_PORTFOLIO_USD=500          # Max total portfolio exposure

# ============================================================================
# Infrastructure Wallet Discovery Configuration
# ============================================================================
# Behavioral wallet discovery system - NO TRADING, only analysis

# Large Sell Detection (% of pool liquidity)
DISCOVERY_MIN_SELL_PCT=1.0                # Min % of pool to qualify as large sell
DISCOVERY_MAX_SELL_PCT=3.0                # Max % (exclude panic dumps)

# Observation Window
DISCOVERY_ABSORPTION_WINDOW_SEC=60        # Time after sell to watch for absorption
DISCOVERY_MAX_RESPONSE_SLOTS=100          # Max slot latency for meaningful absorption

# Absorption Thresholds
DISCOVERY_MIN_ABSORPTION_PCT=20           # Min % of sell absorbed by wallet
DISCOVERY_MAX_ABSORPTION_PCT=80           # Max % (exclude single buyer dominance)

# Stabilization Validation
DISCOVERY_STABILIZATION_WINDOW_SEC=300    # Time to validate stabilization (5 min)
DISCOVERY_MAX_PRICE_DROP_PCT=5.0          # Max price drop during stabilization
DISCOVERY_MIN_VOLUME_CONTRACTION_PCT=30   # Min volume decrease required

# Longitudinal Scoring (Most Important)
SCORING_MIN_EVENTS=3                      # Min absorption events to classify as infra
SCORING_MIN_TOKENS=2                      # Min unique tokens defended
SCORING_MIN_STABILIZATION_RATE=0.6        # Min 60% stabilization success rate
SCORING_CONFIDENCE_DECAY_DAYS=7           # Confidence halves every N days
SCORING_MIN_CONFIDENCE=30                 # Min confidence to maintain tracking
SCORING_MAX_TRACKED_WALLETS=1000          # Max wallets to track

